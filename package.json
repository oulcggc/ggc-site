{
	"name": "ggc-site",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#assets/*": "./src/assets/*",
		"#data/*": "./src/data/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/qrcode": "^1.5.6",
		"@types/qs": "^6.15.1",
		"autoprefixer": "^10.6.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"postcss": "^8.5.28",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"@iconify/json": "^2.2.538",
		"qrcode": "^1.5.4",
		"qs": "^6.16.0",
		"svelte-hamburgers": "^5.0.0",
		"svelte-inview": "^4.0.4",
		"tippy.js": "^6.3.7",
		"unplugin-icons": "^24.0.0"
	}
}
